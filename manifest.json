{
  "manifest_version": 3,
  "name": "FMKorea GIFs",
  "version": "0.0.1",
  "description": "Pick Tenor GIFs for FMKorea comments, and show Tenor links in comments as GIFs.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://tenor.com/*",
    "https://tenor.googleapis.com/*",
    "https://*.fmkorea.com/*",
    "https://fmkorea.com/*"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fmkorea.com/*",
        "https://fmkorea.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
